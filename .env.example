# Прод-переменные для docker-compose.prod.yml (на сервере скопируй в .env).
# Подставляются в docker-compose при развёртывании.

# Токен бота из @BotFather (@nyamical_bot)
BOT_TOKEN=

# Ключ Groq (console.groq.com/keys)
GROQ_API_KEY=

# Пароль пользователя БД в контейнере Postgres (придумай любой надёжный)
DB_PASSWORD=change-me-strong-password
