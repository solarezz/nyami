# Токен бота из @BotFather. Без него авторизация Telegram работает в dev-режиме (тестовый юзер).
BOT_TOKEN=

# Порт API
PORT=8787

# Разрешённый источник фронтенда (CORS). Для локальной разработки:
WEB_ORIGIN=http://localhost:5173

# --- AI-провайдер ---
# Какой провайдер: groq | gemini | mock. Пусто = авто (groq при наличии ключа, иначе mock).
AI_PROVIDER=

# Groq (console.groq.com/keys) — бесплатный тариф, не гео-блокируется.
GROQ_API_KEY=

# Gemini (Google AI Studio) — на будущее/для прода в поддерживаемом регионе.
GEMINI_API_KEY=

# Строка подключения PostgreSQL (подключим на следующем шаге).
DATABASE_URL=
